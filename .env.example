# Entorno: local | dev | test | staging | prod
ENVIRONMENT=local
DEBUG=true

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
LOG_INCLUDE_SOURCE=false

# PostgreSQL (docker compose)
POSTGRES_USER=dispensario
POSTGRES_PASSWORD=dispensario
POSTGRES_DB=dispensario
POSTGRES_PORT=5433

# Conexion de la app cuando corre en el host
DATABASE_URL=postgresql+asyncpg://dispensario:dispensario@localhost:5433/dispensario

# JWT (en produccion el secreto debe tener >=32 caracteres y no ser el de ejemplo)
JWT_SECRET=dev-only-insecure-change-me-in-production-000000
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# Rate limiting del login (ventana deslizante en memoria)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# CORS (frontend Angular). Origenes separados por comas o JSON: ["http://localhost:4200"]
# Vacio = CORS deshabilitado. En produccion no se admite "*": define los origenes explicitos.
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,X-Request-ID

# Contrasena del administrador inicial para `python -m app.cli create-admin`
# Si no se define, el CLI la pide por consola. No se acepta por argumento.
# ADMIN_PASSWORD=
