{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "team-lead",
  "permissions": [
    { "action": "shell", "resource": "git push*", "effect": "deny" },
    { "action": "shell", "resource": "git remote add*", "effect": "deny" },
    { "action": "shell", "resource": "git remote set-url*", "effect": "deny" }
  ],
  "policies": [
    { "action": "tool.use", "resource": "shell:git push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push --force *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh pr merge *", "effect": "deny" }
  ],
  "mcp": {
    "postgres": {
      "type": "local",
      "command": ["docker", "run", "-i", "--rm", "-e", "DATABASE_URI",
                  "crystaldba/postgres-mcp", "--access-mode=restricted"],
      "environment": { "DATABASE_URI": "postgresql://dispensario:dispensario@localhost:5433/dispensario" },
      "enabled": true,
      "timeout": 60000
    }
  }
}
